# Optional: copy to .env (gitignored) to let the local Unity Catalog vend
# credentials for a real ADLS Gen2 account (hierarchical namespace on).
# The service principal needs "Storage Blob Delegator" and "Storage Blob
# Data Reader" on the storage account; see README.md, "Azure".
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=
AZURE_STORAGE_ACCOUNT=youraccount
# A Delta table in that account, registered in Unity Catalog as
# lake.default.users_azure. Must use the abfss://container@account form.
AZURE_TABLE_PATH=abfss://container@youraccount.dfs.core.windows.net/path/to/table
